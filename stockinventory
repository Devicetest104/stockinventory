import csv
import re

# Regex to match a 10-digit number
pattern = re.compile(r'\b\d{10}\b')

# Track unique 8-digit prefixes
seen_numbers = set()

# Store results for later use
results = []

try:
    with open('Stockinventory.csv', 'r', newline='', encoding='utf-8', errors='ignore') as csvfile:
        reader = csv.reader(csvfile)

        for row in reader:
            if not row:
                continue

            cell = row[0].replace("\ufeff", " ", 1)
            match = pattern.search(cell)

            if not match:
                continue

            ten_digit_number = match.group()
            # Strip whitespace from the 8-digit prefix
            first_8_digits = ten_digit_number[:8].strip()

            if first_8_digits in seen_numbers:
                continue

            seen_numbers.add(first_8_digits)

            parts = cell.split()
            model_name = ' '.join(parts[2:]).strip() if len(parts) > 3 else "Unknown"

            results.append((first_8_digits, model_name))
            print(f"8-digit IMEI: {first_8_digits}| Model Name: {model_name}")

except UnicodeDecodeError:
    print("Error decoding with UTF-8. Try opening with a different encoding (e.g., latin-1).")

# Optional: Save results to a new CSV file
if results:
    with open('FilteredOutput.csv', 'w', newline='', encoding='utf-8') as outfile:
        writer = csv.writer(outfile)
        writer.writerow(["IMEI Prefix", "Model Name"])
        writer.writerows(results)
    print("\nResults saved to FilteredOutput.csv")
