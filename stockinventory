import csv
import re
#import win32com.client

# Regular expression to match a 10-digit number
pattern = re.compile(r'\b\d{10}\b')

# Set to store unique 8-digit numbers
seen_numbers = set()


# Connect to Outlook
#outlook = win32com.client.Dispatch("Outlook.Application").GetNamespace("MAPI")

# Access the Inbox (folder index 6 is usually the Inbox)
